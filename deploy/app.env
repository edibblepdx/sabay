# Canonical configuration. Install at /etc/sabay/app.env (root:sabay, mode 0640).
# Set the production secret on the server; never commit it.
APP_DIR=/home/sabay/app
PYENV_ROOT=/home/sabay/.pyenv
HEALTH_URL=http://127.0.0.1:8080/
DEPLOY_SERVICES='sabay-gunicorn.service sabay-daphne.service'
DJANGO_SETTINGS_MODULE=sabay.production_settings
DJANGO_SECRET_KEY=''
DJANGO_DB_PATH=/home/sabay/data/db.sqlite3
DJANGO_STATIC_ROOT=/home/sabay/static
