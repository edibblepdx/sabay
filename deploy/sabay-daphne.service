[Unit]
Description=Sabay Django WebSockets (Daphne)
After=network.target

[Service]
User=sabay
Group=sabay
WorkingDirectory=/home/sabay/app
EnvironmentFile=/etc/sabay/app.env
Environment=PYENV_ROOT=/home/sabay/.pyenv
Environment=PATH=/home/sabay/.pyenv/shims:/home/sabay/.pyenv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'export PYENV_VERSION="$(/home/sabay/.pyenv/bin/pyenv global)"; exec /home/sabay/.pyenv/bin/pyenv exec daphne -b 127.0.0.1 -p 8001 sabay.asgi:application'
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
